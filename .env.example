# ==========================================================================
# Example environment file.
#
# Copy it to a file named  .env  and fill in the values:
#
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# server.js loads this through dotenv at startup. On Render (or any other
# host) there is no .env file - set these in the dashboard instead, and
# dotenv simply finds nothing and moves on.
#
# NEVER commit a filled-in .env. It is already in .gitignore.
# ==========================================================================

# Port the server listens on. Render sets this itself, so leave it alone
# there; locally it defaults to 3000 if unset.
PORT=3000


# --- WhatsApp Cloud API ----------------------------------------------------
#
# Without WHATSAPP_API_TOKEN and WHATSAPP_PHONE_ID the bot runs in MOCK MODE:
# it works out the right reply and logs it instead of sending. That is the
# correct setting for `npm run simulate` and for the test suite, and it means
# you can build and test everything before you have a Meta account.

# A permanent access token. The one shown on the app dashboard expires after
# 24 hours - for anything real, create a System User under
# Business Settings -> Users -> System Users, give it the WhatsApp app, and
# generate a token with whatsapp_business_messaging and
# whatsapp_business_management. That one does not expire.
WHATSAPP_API_TOKEN=

# ID of the WhatsApp business phone number that sends the messages.
# WhatsApp -> API Setup in the Meta dashboard. This is NOT the phone number
# itself - it is a long numeric ID next to it.
WHATSAPP_PHONE_ID=

# A password you invent yourself, any random string. Meta echoes it back when
# verifying the webhook URL and routes/webhook.js checks it matches.
# Put the SAME string in the Meta dashboard's "Verify token" box.
# Without this set, verification always fails and Meta refuses to save the
# webhook at all.
WHATSAPP_VERIFY_TOKEN=

# App Settings -> Basic -> App Secret in the Meta dashboard.
#
# Meta signs every incoming webhook with this. Without it the server accepts
# unsigned requests and logs a warning - fine while developing, but it means
# anyone who finds your URL can file complaints as any phone number they
# like. Set it before going live.
WHATSAPP_APP_SECRET=


# --- Admin API -------------------------------------------------------------
#
# /api/complaints hands out customer names, phone numbers and home addresses,
# so it requires this key in an X-Api-Key header. Invent a long random string.
#
# With this unset those routes return 503 rather than defaulting to open, so
# forgetting it fails loudly instead of publishing the customer database.
# Nothing in the WhatsApp flow needs it - only an admin view or the CRM.
ADMIN_API_KEY=


# The same routes, but a second key for whoever imports complaints into the
# CRM. Separate on purpose: theirs can be rotated or revoked without locking
# you out of your own service, and the logs record which key was used.
PARTNER_API_KEY=


# --- CRM (the client's portal) ---------------------------------------------
#
# THIS IS THE INTEGRATION SLOT. Set these two and implement sendToCRM() in
# services/crmService.js, and every complaint the bot takes starts flowing
# into the portal. Nothing else needs changing.
#
# Leave them blank and the bot still works: complaints are taken, answered and
# saved to data/complaints.json - they just do not reach the portal. That is
# the correct state until the integration is in place.

# Base URL of the portal's API, e.g. https://crm.example.com/api/v1
CRM_API_URL=

# The API key or token the portal issues for this integration
CRM_API_KEY=


# --- Testing ---------------------------------------------------------------
# Set to 1 to expose /health/session/:key and /health/reset, which the test
# suite uses to wait for the bot to finish handling a message.
# Leave this unset everywhere else.
ENABLE_TEST_HOOKS=
